<configuration>
  <property name="LOG_PATTERN"
            value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] %logger{36} - %msg%n" />

  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>${LOG_PATTERN}</pattern>
    </encoder>
  </appender>

  <!-- Async wrapper to avoid log I/O on request threads -->
  <appender name="ASYNC_STDOUT" class="ch.qos.logback.classic.AsyncAppender">
    <queueSize>4096</queueSize>
    <!-- 0 = never pre-emptively drop INFO/DEBUG when the queue gets low. -->
    <discardingThreshold>0</discardingThreshold>
    <includeCallerData>false</includeCallerData>
    <!--
      Logback's default is false, which makes a FULL queue block the calling
      thread — i.e. exactly the request threads this appender exists to protect.
      Under a log burst that turns a logging problem into a latency problem
      across every in-flight request. For an API, dropping log lines is the
      correct trade.
    -->
    <neverBlock>true</neverBlock>
    <maxFlushTime>2000</maxFlushTime>
    <appender-ref ref="STDOUT"/>
  </appender>

  <root level="INFO">
    <appender-ref ref="ASYNC_STDOUT"/>
  </root>
</configuration>
