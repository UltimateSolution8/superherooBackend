# Superherooo API — environment template
#
# Copy to .env for local development, or set these in /etc/superheroo/api.env on
# the server. Never commit a filled-in copy.
#
# Values marked REQUIRED have no default: the app refuses to start without them.
# That is deliberate — the alternative is silently booting with a placeholder.

# ─── Security (REQUIRED) ─────────────────────────────────────────────────────
# Generate each with: openssl rand -hex 32
# Must be at least 32 characters and must differ from one another. Changing
# these invalidates every existing session.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Local development only. Returns the OTP in the API response, which is an
# authentication bypass. Must stay false (or unset) in every deployed environment.
OTP_RETURN_IN_RESPONSE=false

# ─── Database (REQUIRED) ─────────────────────────────────────────────────────
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
DATABASE_SSL=true
DATABASE_SSLMODE=require
SPRING_JPA_HIBERNATE_DDL_AUTO=none

# ─── Redis (REQUIRED) ────────────────────────────────────────────────────────
# Backs OTP storage, rate limiting, and helper presence for the matching engine.
REDIS_URL=

# ─── Object storage ──────────────────────────────────────────────────────────
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=ap-south-1
SUPABASE_S3_BUCKET=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_ACCESS_KEY_SECRET=

# ─── Email delivery ──────────────────────────────────────────────────────────
# Providers are tried in order: MojoAuth, then SMTP. Amazon SES will slot in
# ahead of SMTP later — see EmailOtpSender.
MOJOAUTH_API_KEY=
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# ─── Payments ────────────────────────────────────────────────────────────────
# Online payments are disabled at launch; the app collects cash/UPI offline and
# the partner confirms in-app. Flip to true (with live keys) to re-enable.
PAYMENTS_ONLINE_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Push notifications ──────────────────────────────────────────────────────
# Supply exactly one. Without it, push falls back to the Expo push API.
FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_SERVICE_ACCOUNT_BASE64=

# ─── Realtime gateway ────────────────────────────────────────────────────────
# The Node service shares JWT_ACCESS_SECRET, so rotate both together.
REALTIME_REDIS_CHANNEL=him:rt:events
REALTIME_HTTP_PUBLISH_URL=
REALTIME_HTTP_PUBLISH_SECRET=

# ─── Observability ───────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_SEND_DEFAULT_PII=false
SENTRY_TRACES_SAMPLE_RATE=0.05

# ─── AI moderation / support drafting ────────────────────────────────────────
# Optional. When unset, AI drafting reports itself unavailable rather than
# falling back to a key baked into the source.
ZENMUX_API_KEY=
LLM_API_KEY=

# ─── Bootstrap admin ─────────────────────────────────────────────────────────
# Creates the first ADMIN on startup. Existing passwords are never overwritten.
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ─── Google Play reviewer accounts ───────────────────────────────────────────
# Ordinary accounts that simply already exist, are email-verified and have
# approved KYC — no auth, geofence or moderation bypasses.
#
# The password is re-applied on every boot, so rotating a value here and
# redeploying reissues the credential. Turn this off once review completes.
REVIEWER_SEED_ENABLED=false
REVIEWER_CITIZEN_EMAIL=
REVIEWER_CITIZEN_PASSWORD=
REVIEWER_CITIZEN_PHONE=
REVIEWER_PARTNER_EMAIL=
REVIEWER_PARTNER_PASSWORD=
REVIEWER_PARTNER_PHONE=
REVIEWER_MEDIATOR_EMAIL=
REVIEWER_MEDIATOR_PASSWORD=
REVIEWER_MEDIATOR_PHONE=

# ─── Service area ────────────────────────────────────────────────────────────
# Set to false ONLY in local development to book outside Hyderabad.
SERVICE_AREA_ENFORCED=true
