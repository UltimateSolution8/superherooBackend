# Superherooo API — environment template
#
# Copy to .env for local development, or set these in /etc/superheroo/api.env on
# the server. Never commit a filled-in copy.
#
# Values marked REQUIRED have no default: the app refuses to start without them.
# That is deliberate — the alternative is silently booting with a placeholder.

# ─── Security (REQUIRED) ─────────────────────────────────────────────────────
# Generate each with: openssl rand -hex 32
# Must be at least 32 characters and must differ from one another. Changing
# these invalidates every existing session.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Local development only. Returns the OTP in the API response, which is an
# authentication bypass. Must stay false (or unset) in every deployed environment.
OTP_RETURN_IN_RESPONSE=false

# ─── Database (REQUIRED) ─────────────────────────────────────────────────────
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
DATABASE_SSL=true
DATABASE_SSLMODE=require
SPRING_JPA_HIBERNATE_DDL_AUTO=none

# ─── Redis (REQUIRED) ────────────────────────────────────────────────────────
# Backs OTP storage, rate limiting, and helper presence for the matching engine.
REDIS_URL=

# ─── Object storage ──────────────────────────────────────────────────────────
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=ap-south-1
SUPABASE_S3_BUCKET=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_ACCESS_KEY_SECRET=

# ─── Email delivery ──────────────────────────────────────────────────────────
# Providers are tried in order: Resend (HTTPS), MojoAuth, then SMTP fallback.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Superherooo <noreply@mail.superherooo.com>
MOJOAUTH_API_KEY=
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# ─── Payments ────────────────────────────────────────────────────────────────
# Online payments are disabled at launch; the app collects cash/UPI offline and
# the partner confirms in-app. Flip to true (with live keys) to re-enable.
PAYMENTS_ONLINE_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Full payout account numbers are encrypted with AES-256-GCM. Keep old keys in
# the keyring during rotation. Format: keyId:base64Key[,keyId:base64Key]
# Generate one with: openssl rand -base64 32
BANK_ACCOUNT_ENCRYPTION_KEYS=
BANK_ACCOUNT_ACTIVE_KEY_ID=
# Razorpay's RBI-backed public IFSC directory is the default.
IFSC_LOOKUP_BASE_URL=https://ifsc.razorpay.com
IFSC_LOOKUP_CONNECT_TIMEOUT_MS=1500
IFSC_LOOKUP_REQUEST_TIMEOUT_MS=3000
RATE_LIMIT_IFSC_LOOKUP_PER_MIN=30
RATE_LIMIT_BANK_CHANGE_OTP_START_PER_MIN=3
RATE_LIMIT_BANK_CHANGE_OTP_VERIFY_PER_MIN=8

# ─── Push notifications ──────────────────────────────────────────────────────
# Supply exactly one. Without it, push falls back to the Expo push API.
FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_SERVICE_ACCOUNT_BASE64=

# ─── Realtime gateway ────────────────────────────────────────────────────────
# The Node service shares JWT_ACCESS_SECRET, so rotate both together.
REALTIME_REDIS_CHANNEL=him:rt:events
REALTIME_HTTP_PUBLISH_URL=
REALTIME_HTTP_PUBLISH_SECRET=

# ─── Observability ───────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_SEND_DEFAULT_PII=false
SENTRY_TRACES_SAMPLE_RATE=0.05

# ─── AI moderation / support drafting ────────────────────────────────────────
# Optional. When unset, AI drafting reports itself unavailable rather than
# falling back to a key baked into the source.
# ─── Task moderation ─────────────────────────────────────────────────────────
# Content moderation is a cascade: a local policy screen decides most tasks with
# no model call, and only ambiguous text is sent to a model. See
# TaskModerationService and the golden set in
# src/test/resources/moderation/golden-tasks.psv.
#
# Both keys may be blank. Locally-clean tasks are still approved and ambiguous
# ones go to human review — booking never breaks. Nothing is auto-approved just
# because a provider is unreachable.
#
# SECURITY: both of these were previously hardcoded in GeminiLlmClient as split
# string literals and used whenever the env var was empty, so production was very
# likely running on them. Treat both as compromised and rotate.
AI_MODERATION_GEMINI_API_KEY=
AI_MODERATION_GROQ_API_KEY=
LLM_API_KEY=

# ─── Bootstrap admin ─────────────────────────────────────────────────────────
# Creates the first ADMIN on startup. Existing passwords are never overwritten.
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ─── Google Play reviewer accounts ───────────────────────────────────────────
# Ordinary accounts that simply already exist, are email-verified and have
# approved KYC — no auth, geofence or moderation bypasses.
#
# The password is re-applied on every boot, so rotating a value here and
# redeploying reissues the credential. Turn this off once review completes.
REVIEWER_SEED_ENABLED=false
REVIEWER_CITIZEN_EMAIL=
REVIEWER_CITIZEN_PASSWORD=
REVIEWER_CITIZEN_PHONE=
REVIEWER_PARTNER_EMAIL=
REVIEWER_PARTNER_PASSWORD=
REVIEWER_PARTNER_PHONE=
REVIEWER_MEDIATOR_EMAIL=
REVIEWER_MEDIATOR_PASSWORD=
REVIEWER_MEDIATOR_PHONE=

# ─── Service area ────────────────────────────────────────────────────────────
# Set to false ONLY in local development to book outside Hyderabad.
SERVICE_AREA_ENFORCED=true

# ─── Maps providers ──────────────────────────────────────────────────────────
# Provider order per capability. See geo/GeoProperties.java for why the order
# differs by capability, and docs/OSRM_SETUP.md for the self-hosted router.
#
# All three keys may be blank: the chain then degrades to local answers (empty
# suggestions, coordinates-as-address, straight-line ETA) and every app flow
# still works. Map *rendering* is unaffected — it uses the Google mobile SDK,
# whose map-load SKU is free and unlimited.

# Ola Maps (Krutrim). Primary for autocomplete / place details / reverse
# geocoding: 500k calls/month free and India-native address data.
OLA_MAPS_API_KEY=

# Sent as the Origin header on every Ola call. Ola enforces its allowed-domains
# list against this header rather than the calling IP, so a server that sends
# none is refused with 403 {"message":"Domain  is not allowed."} — the empty
# domain in that message is the tell. Must match an entry (or wildcard) in the
# credential's allowed domains in the Ola console.
OLA_MAPS_ORIGIN=https://api.mysuperhero.xyz

# Self-hosted OSRM. Primary for routing and the matching ETA matrix — free,
# unlimited and ~5ms. NEVER set this to router.project-osrm.org: that demo
# server's policy allows withdrawal without notice.
OSRM_BASE_URL=

# Google Places/Geocoding/Directions, used only as the residual fallback so it
# stays inside the 10k/month-per-SKU free tier. This must be a DIFFERENT key
# from the Android render key: this one is IP-restricted and server-side, that
# one is package+SHA-1 restricted and ships inside the APK.
GOOGLE_MAPS_SERVER_API_KEY=
