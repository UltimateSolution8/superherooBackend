port: 7880
log_level: info

rtc:
  tcp_port: 7881
  udp_port: 7882
  use_external_ip: true
  allow_tcp_fallback: true

# Replace this entry only in /etc/livekit/livekit.yaml (mode 0600).
# The same values are supplied to Backend as LIVEKIT_API_KEY/SECRET.
keys:
  replace-api-key: replace-with-a-cryptographically-random-api-secret

turn:
  enabled: true
  domain: turn.mysuperhero.xyz
  udp_port: 443
  tls_port: 5349
  cert_file: /etc/livekit/certs/turn-fullchain.pem
  key_file: /etc/livekit/certs/turn-privkey.pem
  ttl_seconds: 300

prometheus_port: 6789

room:
  empty_timeout: 300
  departure_timeout: 20
  max_participants: 2
