# /etc/superheroo/api.env — infrastructure knobs only.
#
# Secrets (JWT, database password, Razorpay, Supabase S3, Firebase, Sentry DSN,
# LLM keys) also live in this file on the server but are deliberately NOT
# listed here. See .claude/production-checklist.md for the rotation list.
#
# Every value below is a default already baked into application.yml. Set one
# here only to override it.

# ---------------------------------------------------------------------------
# Health — REQUIRED IN PRODUCTION.
#
# These were previously all false "for demo stability", which made
# /actuator/health return UP with the database down. The deploy gate and any
# load-balancer check were blind. Do not turn them off again.
#
# Verify with the STATUS CODE, not the body: management.endpoint.health
# .show-details defaults to "never", so a healthy response is a bare
# {"status":"UP"} with no component list either way. Correct behaviour is
# 200/UP normally and 503/DOWN when Postgres or Redis is unreachable.
# ---------------------------------------------------------------------------
MANAGEMENT_HEALTH_DEFAULTS_ENABLED=true
MANAGEMENT_HEALTH_DB_ENABLED=true
MANAGEMENT_HEALTH_REDIS_ENABLED=true
# SMTP is optional and email flows degrade gracefully.
MANAGEMENT_HEALTH_MAIL_ENABLED=false
# RabbitMQ is optional: notifications fall back to direct push.
MANAGEMENT_HEALTH_RABBIT_ENABLED=false

# ---------------------------------------------------------------------------
# Web tier — sized for 2 vCPU / 4 GB.
# ---------------------------------------------------------------------------
TOMCAT_MAX_THREADS=48
TOMCAT_MIN_THREADS=8
TOMCAT_ACCEPT_COUNT=100
TOMCAT_MAX_CONNECTIONS=2000
# nginx handles gzip; compressing twice wastes CPU.
TOMCAT_COMPRESSION_ENABLED=false

# ---------------------------------------------------------------------------
# Database pool.
#
# SchedulerLock takes TWO connections per running job, so the scheduler pool
# reserves 2 x SCHEDULER_POOL_SIZE. Keep maximum-pool-size above that with
# headroom for HTTP.
#
# Check which Supabase endpoint SPRING_DATASOURCE_URL points at:
#   5432 = direct/session mode      -> pg_try_advisory_lock works (required)
#   6543 = Supavisor transaction    -> session advisory locks are NOT safe;
#                                      SchedulerLock would silently double-run
#                                      jobs across instances.
# ---------------------------------------------------------------------------
HIKARI_MAX_POOL_SIZE=12
HIKARI_MIN_IDLE=4
HIKARI_CONNECTION_TIMEOUT_MS=10000
HIKARI_IDLE_TIMEOUT_MS=300000
HIKARI_LEAK_DETECTION_MS=60000
PG_CONNECT_TIMEOUT_S=5
PG_SOCKET_TIMEOUT_S=30

# Also run once against the database, per role — the only real defence against
# a runaway report query pinning a connection:
#   ALTER ROLE <api_role> SET statement_timeout = '30s';
#   ALTER ROLE <api_role> SET idle_in_transaction_session_timeout = '60s';

# ---------------------------------------------------------------------------
# Hibernate.
# ---------------------------------------------------------------------------
HIBERNATE_BATCH_SIZE=50
# Log any query slower than this. Set to 0 to log everything while profiling.
HIBERNATE_SLOW_QUERY_MS=300
HIBERNATE_STATS=false

# ---------------------------------------------------------------------------
# Background work.
# ---------------------------------------------------------------------------
SCHEDULER_POOL_SIZE=3
ASYNC_MAX_SIZE=6
ASYNC_QUEUE_CAPACITY=200
REALTIME_DISPATCH_POOL_SIZE=4
OTP_DELIVERY_POOL_SIZE=3

# Cap on how many nearby SEARCHING tasks a single partner "go online" fans out
# to. Each one is a full dispatch cycle with a row lock, so keep it small.
GO_ONLINE_DISPATCH_LIMIT=15

# Max ids accepted by an admin bulk endpoint in one request.
ADMIN_BULK_MAX_ITEMS=200

# ---------------------------------------------------------------------------
# Redis.
#
# REDIS_URL is REQUIRED and was previously absent from this file, which made the
# topology ambiguous: the migration runbook says to keep pointing at Upstash,
# while both systemd units order After=redis-server.service and the realtime
# gateway's env example points at 127.0.0.1. The API and the gateway MUST share
# one Redis instance — they communicate over the him:rt:events pub/sub channel,
# and if they are split the bridge is silently dead (RealtimePublisher logs
# "no subscribers") and realtime delivery falls back to HTTP.
#
# Managed Upstash:   rediss://default:<password>@<host>:<port>
# Local redis-server: redis://127.0.0.1:6379
# Whichever you choose, set the identical value in the realtime gateway's env.
#
# Upstash bills per command, not per round trip. The presence heartbeat is the
# dominant cost line; see HelperPresenceService for what each beat spends.
# ---------------------------------------------------------------------------
REDIS_URL=
REDIS_TIMEOUT=2s
REDIS_CONNECT_TIMEOUT=2s
REDIS_POOL_ENABLED=false

# ---------------------------------------------------------------------------
# Maps providers. See Backend/docs/OSRM_SETUP.md and geo/GeoProperties.java.
#
# Every key here may be blank — the provider chain degrades to local answers and
# no user flow breaks. Map rendering is separate and always free (Google mobile
# SDK map-load SKU).
# ---------------------------------------------------------------------------
# Primary for autocomplete, place details and reverse geocode (500k/month free).
# Everything except create-task address entry is answered from here, so a blank
# key means the whole product falls back to the built-in locality index.
OLA_MAPS_API_KEY=
# Sent as the Origin header on every Ola call. Ola checks its allowed-domains list
# against this header, not the caller's IP, so leaving it unset gets every request
# refused with 403 {"message":"Domain  is not allowed."}. Must be covered by the
# credential's allowed domains in the Ola console (wildcards such as
# *.mysuperhero.xyz are accepted there).
OLA_MAPS_ORIGIN=https://api.mysuperhero.xyz
# Primary for routing + matching ETA matrix. Loopback only, never the demo server.
OSRM_BASE_URL=http://127.0.0.1:5001
# What the extract actually covers (minLat,minLng,maxLat,maxLng). Must match the clip
# in build-osrm-hyderabad.sh, which writes the same box lng-first as
# 77.8267,16.7550,79.1467,18.0150. Any route with an endpoint outside this skips OSRM
# rather than waiting for it to answer NoSegment. Set blank once the extract is national.
OSRM_COVERAGE_BBOX=16.7550,77.8267,18.0150,79.1467
# Must equal --max-table-size in deploy/superheroo-osrm.service. A larger /table request
# fails outright, which would silently drop dispatch ranking back to straight-line
# distance, so the API declines locally instead.
OSRM_MAX_TABLE_SIZE=64
# Route geometry and dispatch matrices use local OSRM first, then Ola's
# distanceMatrix endpoint; Google is a residual last resort.
GEO_ROUTING_ORDER=osrm,ola,google
# Text lookups lead with Ola: 500k calls/month free against Google's 10k, and the
# quality gap only shows where a citizen types an address they have not saved.
GEO_AUTOCOMPLETE_ORDER=ola,local
GEO_PLACE_DETAILS_ORDER=ola,local
GEO_REVERSE_GEOCODE_ORDER=ola,google
# The one place Google leads. GEO_PREMIUM_CONTEXTS is the allowlist of request
# contexts allowed to use it — the app sends what it is doing, never which provider
# it wants, so this is the only thing that decides what gets billed. Clearing this
# variable turns Google off entirely without an app release.
#
# Note that Google still serves place details for its own suggestions regardless of
# GEO_PLACE_DETAILS_ORDER: a google: place id can only be resolved by Google. That
# is one Essentials call per accepted suggestion and it is unavoidable. Ola
# suggestions carry coordinates inline and cost no details call at all.
GEO_PREMIUM_AUTOCOMPLETE_ORDER=google,ola,local
GEO_PREMIUM_CONTEXTS=task_create
# Billable Google calls per calendar month before the chain falls back to Ola for
# the rest of the month. 12000 sits just above the 10k/month per-SKU free tier, so
# the most an unattended retry loop can cost is the overshoot. Set a matching daily
# quota cap in the Cloud Console for the real hard limit. 0 disables. Routing is
# never capped — it only reaches Google when OSRM and Ola are both down, and no
# route at all is worse than the call.
GEO_GOOGLE_MONTHLY_CALL_CAP=12000
# Premium requests one account may make per day, so a single client cannot drain
# the shared monthly budget. Past it that user gets Ola for the rest of the day.
GEO_GOOGLE_USER_DAILY_CALL_CAP=150
# Server-side Places/Geocoding/Directions key. Must be IP-restricted and distinct
# from the APK's package-restricted render key — Google's application restrictions
# are mutually exclusive, so one key cannot safely do both.
GOOGLE_MAPS_SERVER_API_KEY=

# ---------------------------------------------------------------------------
# Matching / dispatch.
#
# Offers escalate in waves: each unanswered offer window searches a wider radius
# and notifies more partners, so a job in a thin-supply area ends up city-wide
# instead of being cancelled after one 3km pass.
# ---------------------------------------------------------------------------
MATCH_WAVE_RADII_METERS=3000,6000,10000
MATCH_WAVE_FANOUTS=8,15,25
# Must match the partner app's on-screen offer countdown.
MATCH_OFFER_TTL_SECONDS=45
# Total search window. Long enough for the escalation to reach the widest tier.
TASK_SEARCH_TIMEOUT_SECONDS=720
# The pull feed is intentionally much wider than a push wave — seeing a job in a
# list costs a partner nothing, and Hyderabad is one service area.
MATCH_PULL_FEED_RADIUS_METERS=15000
# The app shows one offer modal at a time; more than this and earlier alerts get
# overwritten while their slots stay locked.
MATCH_MAX_LIVE_OFFERS_PER_HELPER=2

# ---------------------------------------------------------------------------
# Response cache (Redis-backed). Reports and admin counters only — never task
# lifecycle, marketplace, auth or payment state.
# ---------------------------------------------------------------------------
CACHE_ENABLED=true

# ---------------------------------------------------------------------------
# Retention (UTC cron). Both purge PII and run outside peak hours, staggered so
# they never hold four database connections at once.
# ---------------------------------------------------------------------------
RETENTION_KYC_CRON=0 30 3 * * *
RETENTION_PUSH_TOKEN_CRON=0 45 3 * * *
RETENTION_PUSH_TOKEN_DAYS=90

# ---------------------------------------------------------------------------
# OTP delivery
#
# Phone + OTP is the primary way into all three apps. With none of these set the
# service still starts and still generates codes — and delivers nothing, so
# sign-in is broken for every user with no error to show for it.
# OtpDeliveryCheckRunner says so loudly at boot; check the first lines of the log
# after a deploy.
#
# Zero-touch auto-read (SMS Retriever) has three requirements, all on the MSG91
# template rather than in this file:
#   1. the message must END with ##var3##, which is the app's signing hash
#   2. the whole message must stay under 140 bytes
#   3. the message must begin with <#>
# Miss any one and auto-read silently never fires — the keyboard suggestion still
# works, so it looks like a flaky feature rather than a misconfiguration.
# ---------------------------------------------------------------------------
MSG91_ENABLED=true
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=SPHROO
MSG91_DLT_TEMPLATE_ID=
MSG91_OTP_EXPIRY_MINUTES=5

# ---------------------------------------------------------------------------
# Google Play reviewer access
#
# Reviewers cannot receive an Indian SMS. These numbers have their OTP
# provisioned instead of texted: startOtp stores the configured code where a
# random one would go, and verification is byte-for-byte the same path, with the
# same five-attempt cap and the same rate limit. Nothing else is granted — no KYC
# change, no geofence waiver, no role escalation.
#
# Both variables are required: REVIEWER_SEED_ENABLED is the single switch that
# turns the whole review arrangement off. SET IT TO false ONCE REVIEW COMPLETES.
# Codes must be six digits; anything shorter is rejected at parse time.
# ---------------------------------------------------------------------------
# REVIEWER_OTP_PHONES=9000000101:472913,9000000102:658204,9000000103:319875

# ---------------------------------------------------------------------------
# Payments — all three switches ship off except the ledger
#
# The ledger only records what already happened, so it is safe with payouts off,
# and it is what makes balances correct on the day they go live. Leaving it off
# during the cash-only period means every partner balance starts at zero later,
# with no history to reconcile against.
#
# See docs/PAYMENTS_GO_LIVE.md for the order these are switched on in.
# ---------------------------------------------------------------------------
PAYMENTS_ONLINE_ENABLED=false
PAYMENTS_LEDGER_ENABLED=true
PAYOUTS_ENABLED=false
PLATFORM_COMMISSION_BPS=1500
MIN_PAYOUT_PAISE=10000

# Money in.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Money out. Deliberately a different credential: an account that can only
# collect cannot be used to drain a balance. account-number is the RazorpayX
# virtual account payouts are funded from — without it every payout is rejected.
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAYX_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# 1 vCPU / 1 GB fallback.
#
# If the droplet has not been resized yet, uncomment this block. G1 needs more
# headroom than a 512m heap gives it, so Serial GC is the better fit at that
# size; and the pool/thread counts must come down with it.
# ---------------------------------------------------------------------------
# JAVA_OPTS=-XX:+UseSerialGC -Xms192m -Xmx512m -XX:MaxMetaspaceSize=192m -XX:MaxDirectMemorySize=96m -XX:ReservedCodeCacheSize=96m -XX:+ExitOnOutOfMemoryError -Duser.timezone=UTC
# TOMCAT_MAX_THREADS=20
# TOMCAT_MAX_CONNECTIONS=1000
# HIKARI_MAX_POOL_SIZE=8
# HIKARI_MIN_IDLE=2
# SCHEDULER_POOL_SIZE=2
# ASYNC_MAX_SIZE=3
# REALTIME_DISPATCH_POOL_SIZE=2
# GO_ONLINE_DISPATCH_LIMIT=8
